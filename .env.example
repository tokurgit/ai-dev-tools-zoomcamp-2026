# Copy this file to `.env` and run with `uv run --env-file .env <command>`.
# Nothing here is required for local dev or for `uv run pytest` — every
# variable has a safe default (see config/settings.py). This file exists so
# production (deploy/app.env, issue #16) and any local override have a single
# documented place to look.

# --- Django core ------------------------------------------------------------

# Required in production (DJANGO_DEBUG=false). In dev, an insecure built-in
# fallback is used if this is left unset — never rely on that in production.
DJANGO_SECRET_KEY=

# Unset (or anything not 1/true/yes, case-insensitive) = production posture
# (DEBUG off, SECRET_KEY mandatory, secure cookies + SSL redirect). Set to
# "true" for local development.
DJANGO_DEBUG=true

# Comma-separated hostnames this instance answers to. Required in production.
# When DJANGO_DEBUG=true and unset, defaults to localhost,127.0.0.1.
DJANGO_ALLOWED_HOSTS=

# Comma-separated Origins trusted for unsafe (CSRF-checked) requests behind
# HTTPS. Defaults to https://<host> for each entry in DJANGO_ALLOWED_HOSTS.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Path to the SQLite database file. Defaults to <repo>/db.sqlite3.
DJANGO_DB_PATH=

# --- izsoles.csv ingest (issue #4) ------------------------------------------

# Local path an operator drops the daily izsoles.csv at. Defaults to
# <repo>/data/izsoles.csv.
IZSOLES_CSV_PATH=

# Open-data feed URL for the best-effort httpx fetcher (--fetch).
IZSOLES_OPEN_DATA_URL=https://izsoles.ta.gov.lv/open_data/izsoles.csv

# Session Cookie: header value for the fetch (the open-data endpoint 403s
# without a real browser session). Optional; the fetch is best-effort.
IZSOLES_FETCH_COOKIE=

# --- Notification email dispatch (issue #9) ---------------------------------

# Dotted path to a auctions.email.NotificationBackend subclass. Defaults to
# ConsoleBackend (prints to stdout) — set to auctions.email.ResendBackend in
# production.
NOTIFICATION_BACKEND=auctions.email.ConsoleBackend

# Required when NOTIFICATION_BACKEND is ResendBackend.
RESEND_API_KEY=
RESEND_FROM=

# URL template for a single listing in notification emails; {source_id} is
# substituted with the listing's izsoles UUID.
LISTING_URL_TEMPLATE=https://izsoles.ta.gov.lv/izsole/{source_id}
