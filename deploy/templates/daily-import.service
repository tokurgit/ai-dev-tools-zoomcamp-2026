# Managed by deploy/bootstrap.sh — do not hand-edit the installed unit at
# /etc/systemd/system/${APP_NAME}-daily-import.service; edit this template
# instead and re-run bootstrap.sh (then `systemctl daemon-reload`).
#
# Rendered with:
#   envsubst '${APP_NAME} ${APP_USER} ${APP_DIR} ${IMPORT_FETCH_FLAG}' \
#     < daily-import.service > /etc/systemd/system/${APP_NAME}-daily-import.service
#
# ${IMPORT_FETCH_FLAG} is computed by bootstrap.sh from app.env's IMPORT_FETCH
# (1/true/yes -> "--fetch", else empty) — envsubst can only substitute text,
# not branch, so the flag is decided in bash before rendering. Default (no
# --fetch) reads the local izsoles.csv an operator drops at IZSOLES_CSV_PATH
# (#4); --fetch additionally tries the open-data URL first, which may 403
# from a VPS IP — see README.md's "izsoles.csv on the VPS" note.
#
# stdout/stderr go to journald under this unit by default — no bespoke
# logfile, no logrotate config needed. See README.md — "Logs".
#
# Extension point (not built, see #17's out-of-scope): add
#   OnFailure=<some-alerting-unit>.service
# under [Unit] to hook a failed run into email/Telegram/Healthchecks.io.

[Unit]
Description=${APP_NAME} daily izsoles.csv import
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${APP_DIR}
EnvironmentFile=/etc/${APP_NAME}/app.env
ExecStart=/usr/local/bin/uv run python manage.py run_daily_import ${IMPORT_FETCH_FLAG}
