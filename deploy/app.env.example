# deploy/app.env.example — copy to deploy/app.env and fill in every value
# before running bootstrap.sh. deploy/app.env is git-ignored: it holds real
# secrets (DJANGO_SECRET_KEY, RESEND_API_KEY) and is never committed.
#
# This file is sourced as plain shell (bootstrap.sh/deploy.sh do
# `set -a; source app.env; set +a`) and is also installed verbatim to
# /etc/$APP_NAME/app.env, where the systemd units read it via
# `EnvironmentFile=`. Keep it in `KEY=value` form — no quoting, no export,
# no command substitution.
#
# Nothing in bootstrap.sh, deploy.sh, smoke.sh or templates/*.conf hardcodes
# a project name, path or domain — every project-specific value lives here.
# See README.md's "Adapting to another Django project" section.

# --- Deploy target (this file, consumed by bootstrap.sh / deploy.sh) -------

# Short, unique name for this deployment. Used as: the systemd unit name
# (<APP_NAME>.service), the Nginx site name, and the config directory
# (/etc/<APP_NAME>/app.env). Lowercase, no spaces, e.g. "izsoles-alerts".
APP_NAME=

# System user the app runs as (created by bootstrap.sh if missing). Owns
# APP_DIR; Gunicorn and the daily-import timer run as this user.
APP_USER=

# Absolute path the app is checked out to, e.g. /srv/izsoles-alerts.
# Created (and git-cloned into) by bootstrap.sh, owned by APP_USER.
APP_DIR=

# Public domain name this deployment answers to, e.g. alerts.example.com.
# A DNS A record for this domain must already point at the box before
# running bootstrap.sh (certbot needs it reachable to issue a certificate).
DOMAIN=

# Git URL bootstrap.sh clones, e.g. git@github.com:you/repo.git or
# https://github.com/you/repo.git.
REPO_URL=

# Git ref checked out on every deploy: a branch, tag, or commit SHA, e.g.
# "main" or "v1.2.0". deploy.sh does `git fetch && git checkout $GIT_REF`
# on every run, so moving this to a new tag and re-running deploy.sh is how
# you ship a release (and moving it back is how you roll back — see README).
GIT_REF=main

# Python version uv installs and runs the app with, e.g. "3.13". Must
# satisfy pyproject.toml's requires-python.
PYTHON_VERSION=3.13

# Number of Gunicorn worker processes.
GUNICORN_WORKERS=3

# --- Daily import timer (issue #17) -----------------------------------------

# Time of day (HH:MM, Europe/Riga) the daily izsoles.csv import runs.
# Substituted straight into the timer's OnCalendar=; see
# templates/daily-import.timer. Defaults to 07:00 if left empty.
IMPORT_SCHEDULE=07:00

# Optional. Set to "true" to pass --fetch to run_daily_import, so it tries
# to download izsoles.csv itself before importing (see #4) instead of only
# reading the local file an operator drops at IZSOLES_CSV_PATH. May 403 from
# a VPS IP — see README.md's "izsoles.csv on the VPS" note. Defaults to
# "false" (no --fetch) if left empty.
IMPORT_FETCH=false

# --- TLS certificate (certbot, bootstrap.sh only) ---------------------------

# Optional. Email certbot registers the Let's Encrypt account with. If left
# empty, bootstrap.sh skips the automatic `certbot --nginx` call and prints
# the manual command to run instead — see README.md.
CERTBOT_EMAIL=

# Optional. Set to "true" to request a Let's Encrypt STAGING certificate
# (not trusted by browsers, but exempt from the real API's rate limits) —
# use this for a first dry run against a new DOMAIN, then unset it and
# re-run bootstrap.sh for the real certificate. Defaults to "false".
CERTBOT_STAGING=false

# --- Django core (see .env.example at the repo root, and config/settings.py) -

# Required — DJANGO_DEBUG is unset below, so config/settings.py treats this
# as production and raises ImproperlyConfigured at startup without it.
DJANGO_SECRET_KEY=

# Any value that is not 1/true/yes (including empty/absent) turns on
# production posture (mandatory SECRET_KEY, secure cookies, HTTPS redirect)
# — see config/settings.py. Explicitly "false" here, not absent, so it's
# obvious at a glance this box is meant to run in production mode.
DJANGO_DEBUG=false

# Comma-separated hostnames this instance answers to. Should normally match
# DOMAIN above, e.g. DJANGO_ALLOWED_HOSTS=alerts.example.com.
DJANGO_ALLOWED_HOSTS=

# Comma-separated Origins trusted for unsafe (CSRF-checked) requests.
# Defaults to https://<host> for each entry in DJANGO_ALLOWED_HOSTS if left
# empty, which is normally sufficient.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Path to the SQLite database file. Back this file up (Hetzner snapshots —
# see README.md). Defaults to <repo>/db.sqlite3 if left empty; an explicit
# path outside APP_DIR (e.g. /var/lib/<APP_NAME>/db.sqlite3) survives a
# `git clean`/re-clone of APP_DIR more safely — your call.
DJANGO_DB_PATH=

# --- izsoles.csv ingest (issue #4) ------------------------------------------

# Local path an operator drops the daily izsoles.csv at; run_daily_import
# reads it from here (see README.md's "izsoles.csv" note). Defaults to
# <repo>/data/izsoles.csv if left empty.
IZSOLES_CSV_PATH=

# Open-data feed URL for the best-effort httpx fetcher (--fetch).
IZSOLES_OPEN_DATA_URL=https://izsoles.ta.gov.lv/open_data/izsoles.csv

# Session Cookie: header value for the fetch (the open-data endpoint 403s
# without a real browser session). Optional; the fetch is best-effort.
IZSOLES_FETCH_COOKIE=

# --- Notification email dispatch (issue #9) ---------------------------------

# Dotted path to an auctions.email.NotificationBackend subclass. Use
# auctions.email.ResendBackend in production (ConsoleBackend just logs).
NOTIFICATION_BACKEND=auctions.email.ResendBackend

# Required when NOTIFICATION_BACKEND is ResendBackend.
RESEND_API_KEY=
RESEND_FROM=

# URL template for a single listing in notification emails; {source_id} is
# substituted with the listing's izsoles UUID.
LISTING_URL_TEMPLATE=https://izsoles.ta.gov.lv/izsole/{source_id}
